# Source cloud project
SOURCE_PROJECT_REF=replace-with-cloud-project-ref
SOURCE_SUPABASE_URL=https://replace-with-cloud-project-ref.supabase.co
SOURCE_SERVICE_ROLE_KEY=replace-with-cloud-service-role-key

# Optional: use a direct source DB URL instead of `supabase link`.
# SOURCE_DB_URL=postgresql://postgres:password@db.example.com:5432/postgres?sslmode=require

# Destination self-hosted project
DEST_SUPABASE_URL=https://supabase.example.com
DEST_SERVICE_ROLE_KEY=replace-with-self-hosted-service-role-key

# Optional: working directory for dumps/reports.
# WORK_ROOT=$HOME/supabase-migration

# Optional flags for the migration helper.
MIGRATE_DB=1
MIGRATE_STORAGE=1
MIGRATE_FUNCTIONS=1
REWRITE_STORAGE_URLS=1

# Safety switches: keep these at 0 unless you understand the consequences.
ALLOW_DROP_INCOMPAT_AUTH=0
ALLOW_NONEMPTY_DESTINATION=0
AUTO_CONFIRM=0
